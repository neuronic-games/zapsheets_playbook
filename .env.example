# Copy this to .env and fill in values for your environment.
# .env is gitignored — never commit it.

ENVIRONMENT=production

# Python binary name (python3 on most servers)
PYTHON=python3

# Subdirectory prefix if the app is not at the domain root.
# Leave as / for root deploys (e.g. http://localhost:8000/).
# Set to /playbook-test for https://zapsheets.com/playbook-test/ deploys.
BASE_PATH=/

# Public-facing domain (no trailing slash). Combined with BASE_PATH to build
# absolute URLs where needed (e.g. TRMNL icon).
# Example: https://zapsheets.com
APP_DOMAIN=http://localhost:8000

# ── Stripe (Pro subscriptions + donations) ──────────────────────────────
# Secret key from Stripe → Developers → API keys (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at push/stripeWebhook.php (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Recurring Pro price for each app (price_…)
STRIPE_PRICE_ID_DEVBOARD=
STRIPE_PRICE_ID_GAMEBOARD=
# One-time price set to "Customer chooses what to pay" (price_…)
STRIPE_PRICE_ID_DONATION=
# Customer portal login link from Stripe → Settings → Billing → Customer portal
STRIPE_PORTAL_URL=
