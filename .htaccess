RewriteOptions inherit
Header always unset X-Frame-Options
Header set Access-Control-Allow-Origin *

RewriteEngine On
DirectoryIndex index.php index.html

# /pushsite[?…] → push/pushsite.php
RewriteRule ^pushsite/?$ push/pushsite.php [L,QSA]

# /pitchboard/help — instructional help page (must come before /pitchboard rule)
RewriteRule ^pitchboard/help/?$ source/pitchboard/help/index.php [L,QSA]
# /pitchboard/features — sales / features page (must come before /pitchboard rule)
RewriteRule ^pitchboard/features/?$ source/pitchboard/features/index.php [L,QSA]

# /game/{hash}/sellsheet — token-based sellsheet (must come before the game rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^game/([a-f0-9]{24})/sellsheet/?$ source/gameview/sellsheet.php [L,QSA]

# /game/{hash} — token-based public game page (no sheet ID in URL)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^game/([a-f0-9]{24})/?$ source/gameview/index.php [L,QSA]

# /pitchboard/share/{hash} — read-only shared pitch view (no sheet ID in URL)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pitchboard/share/([a-f0-9]{24})/?$ source/pitchboard/shared/index.php [L,QSA]

# /pitchboard — setup landing page
RewriteRule ^pitchboard/?$ source/pitchboard/index.php [L,QSA]

# /devboard — setup landing page (no sheet ID yet)
RewriteRule ^devboard/?$ source/devboard/index.php [L,QSA]

# /fitboard — setup landing page (no sheet ID yet)
RewriteRule ^fitboard/?$ source/fitboard/setup/index.php [L,QSA]

# Short-URL: /{id}/devboard → source/devboard/dashboard/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/devboard/?$ source/devboard/dashboard/index.php [L,QSA]

# Also cover sheets/{id}/devboard
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/devboard/?$ source/devboard/dashboard/index.php [L,QSA]

# Short-URL: /{id}/pitchboard/slides — game slideshow (must come BEFORE /pitchboard rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pitchboard/slides/?$ source/slides/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/pitchboard/slides/?$ source/slides/index.php [L,QSA]

# Short-URL: /{id}/pitchboard → source/dashboard/index.php (single source, no per-sheet copy)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pitchboard/?$ source/dashboard/index.php [L,QSA]

# Also cover sheets/{id}/pitchboard in case of direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/pitchboard/?$ source/dashboard/index.php [L,QSA]

# Backward compat: old /dashboard URLs still work
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/dashboard/?$ source/dashboard/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/dashboard/?$ source/dashboard/index.php [L,QSA]

# Short-URL: /{id}/view → source/view/index.php (single source, no per-sheet copy)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/view/?$ source/view/index.php [L,QSA]

# Also cover sheets/{id}/view for old bookmarks / direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/view/?$ source/view/index.php [L,QSA]

# Short-URL: /{id}/sellsheet → source/sellsheet/index.php (single source, no per-sheet copy)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/sellsheet/?$ source/sellsheet/index.php [L,QSA]

# Also cover sheets/{id}/sellsheet for old bookmarks / direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/sellsheet/?$ source/sellsheet/index.php [L,QSA]

# Short-URL: /{id}/trmnl → source/trmnl/index.php (TRMNL e-paper plugin)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/trmnl/?$ source/trmnl/index.php [L,QSA]

# Also cover sheets/{id}/trmnl for direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/trmnl/?$ source/trmnl/index.php [L,QSA]

# Short-URL: /{id}/fitboard/onboard → onboarding page (must come before /{id}/fitboard rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/fitboard/onboard/?$ source/fitboard/onboard/index.php [L,QSA]

# Short-URL: /{id}/fitboard → source/fitboard/index.php (single source, no per-sheet copy)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/fitboard/?$ source/fitboard/index.php [L,QSA]

# Also cover sheets/{id}/fitboard/onboard
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/fitboard/onboard/?$ source/fitboard/onboard/index.php [L,QSA]

# Also cover sheets/{id}/fitboard for old bookmarks / direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/fitboard/?$ source/fitboard/index.php [L,QSA]

# /noteboard/help — help page (must come before /noteboard rule)
RewriteRule ^noteboard/help/?$ source/noteboard/help/index.php [L,QSA]

# /noteboard — setup landing page
RewriteRule ^noteboard/?$ source/noteboard/index.php [L,QSA]

# Short-URL: /{id}/noteboard/{hash} — public feedback form (must come before list rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/noteboard/([a-f0-9]+)/?$ source/noteboard/form/index.php [L,QSA]

# Short-URL: /{id}/noteboard — list view
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/noteboard/?$ source/noteboard/list/index.php [L,QSA]

# Also cover sheets/{id}/noteboard/{hash} for direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/noteboard/([a-f0-9]+)/?$ source/noteboard/form/index.php [L,QSA]

# Also cover sheets/{id}/noteboard for direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/noteboard/?$ source/noteboard/list/index.php [L,QSA]

# /share/{token} — shared read-only PulseBoard view
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^share/([A-Za-z0-9]+)/?$ source/pulseboard/shared/index.php [L,QSA]

# /pulseboard/help — help page
RewriteRule ^pulseboard/help/?$ source/pulseboard/help/index.php [L,QSA]

# /pulseboard — setup landing page
RewriteRule ^pulseboard/?$ source/pulseboard/index.php [L,QSA]

# Short-URL: /{id}/pulseboard/pulse — machine heartbeat POST (must come before list rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/pulse/?$ push/pulsePulseboard.php [L,QSA]

# Short-URL: /{id}/pulseboard/icon.png — home-screen app icon
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/icon\.png$ source/pulseboard/icon.php [L,QSA]

# Short-URL: /{id}/pulseboard/manifest.json — web app manifest
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/manifest\.json$ source/pulseboard/manifest.php [L,QSA]

# Short-URL: /{id}/pulseboard/sw.js — service worker for offline caching
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/sw\.js$ source/pulseboard/sw.php [L,QSA]

# Short-URL: /{id}/pulseboard/note — save machine notes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/note/?$ push/saveNotePulseboard.php [L,QSA]

# Short-URL: /{id}/pulseboard — machine status dashboard
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/pulseboard/?$ source/pulseboard/list/index.php [L,QSA]

# Also cover sheets/{id}/pulseboard/pulse for direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/pulseboard/pulse/?$ push/pulsePulseboard.php [L,QSA]

# Also cover sheets/{id}/pulseboard for direct links
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sheets/([A-Za-z0-9_\-]+)/pulseboard/?$ source/pulseboard/list/index.php [L,QSA]

# Short-URL: /{id}/site  → add trailing slash (301)
RewriteRule ^([A-Za-z0-9_\-]+)/site$ %{REQUEST_URI}/ [R=301,L]

# Short-URL: /{id}/site/  → source/site/index.php (single source, no per-sheet copy)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/site/?$ source/site/index.php [L,QSA]

# Short-URL: /{id}/site/… → source/site/… (game.php, contact.php, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_\-]+)/site/(.+)$ source/site/$2 [L,QSA]

# Short-URL: /{id}[/…] → redirect to /sheets/{id}[/…]
#
# Guard 1: skip real files and real directories (e.g. push/, js/, css/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Guard 2: skip known top-level names regardless of subdirectory prefix.
#          Matches  /anything/name/  or  /anything/name  at end of URI.
RewriteCond %{REQUEST_URI} !/(js|css|fonts|images|sheets|source|push|menu|steps|manifest|sw_playbook|result|dotEnv|clear-sw|debug-jquery|router|start|test|index|site|pitchboard|devboard|fitboard|noteboard|pulseboard|slides-sw|game|shares)(/|$)
RewriteRule ^([A-Za-z0-9_\-]+)(/.*)?$ sheets/$1$2 [R=302,L]
