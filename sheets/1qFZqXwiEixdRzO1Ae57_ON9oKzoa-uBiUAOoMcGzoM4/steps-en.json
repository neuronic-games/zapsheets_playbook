[{"ID": "START", "Type": "loading", "Image": "", "Preview": "", "Text": "Step-by-step guide for Scurry Up!", "Duration": 1, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Follow the step-by-step instructions below.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "DOWNLOAD GUIDE, https://www.uncommonspublishing.com/app/floristry/files/Floristry_Rules_V1.7-EN.pdf", "Button": "DOWNLOAD GUIDE", "Button URL": "https://www.uncommonspublishing.com/app/floristry/files/Floristry_Rules_V1.7-EN.pdf"}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Connect the 3 Tree Boards as shown below.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Place the [BERRY] [NUT] [BUG] within reach of players.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Shuffle the pink Branch Cards. Starting at the top of the tree, place 1 pink card, face-down, on each side of the tree.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Shuffle the yellow Branch Cards. Place 2 rows of cards, face-down, below the pink cards.\n", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Shuffle the blue Branch Cards. Place 4 rows of cards, face-down, below the yellow cards.\nReturn unused cards to the box.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/4f3qw5e5jbksbqm26dr70/su_ex_1.jpg?rlkey=ruyx5p80heasxq8u0wmd5xlpx&dl=1", "Preview": "", "Text": "Give each player a Squirrel card and the matching color die and squirrel tokens.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "OBJECTIVE", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "In Scurry Up!, you’re a squirrel, scurrying up a gigantic tree to collect tasty treats! You’ll climb 7 branches (7 rounds), and whoever gathers the most points wins.\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "Each round, you will Scout, Scurry and Stash. ", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "Scout: Reveal the next branch card(s).\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "Scurry: Secretly and simultaneously pick a branch location.\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "Stash: Collect rewards or Oops ([OOPS]).\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/wrdj3wh2is42alkxqixhq/Scurry-Up-BG.webp?rlkey=sukj74grd051w3i0rva472q9h&dl=1", "Preview": "", "Text": "After 7 rounds, the game ends. \nTally your points and determine the winner.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "SCOUT: Flip over the lowest left card that is face-down. This card shows locations 1, 2, and 3 and is the next branch you climb.\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "4-6 players?  Also flip over the right card.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": " For 4 players, tuck the first 2 locations of this card under the tree board, leaving 4 total locations visible.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "For 5 players tuck 1 location, leaving 5 total locations visible. ", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "For 6 players leave all 6 locations.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "SCURRY: \nThere are three types of branch locations. Secretly decide where you want to go on the next branch by selecting the number on your die that matches the available location.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "Negotiate away! But remember, people may lie! ", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "While setting your die, use your hand to hide your number. Put your thumb up (like a squirrel tail) when you are ready.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/zlntjvwb2hpyqz6u5mhxu/scout.webp?rlkey=l0xln7zd1s4d4r03aq9fqewg1&dl=1", "Preview": "", "Text": "Once all players have their thumbs up, simultaneously reveal your dice and move your Large Squirrels to their locations. ", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "LOCATIONS", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ypctguqu8g06tvmnb4ctc/card.webp?rlkey=y87hk52jmgdwoar31cupbcfwp&dl=1", "Preview": "", "Text": "3 Types of Branch Locations: Sungle, Double, Co-op Location", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ypctguqu8g06tvmnb4ctc/card.webp?rlkey=y87hk52jmgdwoar31cupbcfwp&dl=1", "Preview": "", "Text": "Single location:\nIf only one squirrel goes here they get the stash!", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ypctguqu8g06tvmnb4ctc/card.webp?rlkey=y87hk52jmgdwoar31cupbcfwp&dl=1", "Preview": "", "Text": "Double location:\nIf only one squirrel goes here, they get the stash, but if  2 go here they share it.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ypctguqu8g06tvmnb4ctc/card.webp?rlkey=y87hk52jmgdwoar31cupbcfwp&dl=1", "Preview": "", "Text": "Co-op location:\nIf 2 and only 2 squirrels go here they each get the stash on their side. If 1 squirrel goes here, they ([OOPS])!", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "Oops! If MORE squirrels land in a location than there are spaces, they all [OOPS] and nobody gets the stash!", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "", "Image": "", "Preview": "", "Text": "", "Duration": "", "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "STASH", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "STASH:\nYou landed on a branch! If you [OOPS], place/move your small squirrel 1 space to the right on the  track.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "All players who did not [OOPS] take rewards simultaneously shown at the top of their branch locations! ", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "Take [BERRY] (=3) [NUT] (=5) [BUG] tokens for treats, and use a Tiny Squirrel to track [FLOWER] at the top of the tree.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "Sharing the Stash: If 2 squirrels go to a location with 2 spaces, they share. Both players roll their die (Roll again if tied) and, starting with the player who rolled higher, alternate picking rewards until they are gone. Each icon with a number is a single reward (i.e. [NUT]).", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ip3x9lc18k95inre48f2a/scurry.webp?rlkey=geuyrb6o33rblq9gyw0b1myi2&dl=1", "Preview": "", "Text": "Once you have completed the top branch (Pink cards) score.\r", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "", "Image": "", "Preview": "", "Text": "", "Duration": "", "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "SCORE", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "SCORE:\nAt the end of the game, use your Large Squirrels to climb the point track on the tree trunk. If you pass 70, begin again at 1. Score the following in order:", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "[OOPS] : 10 points for 1st, 5 points for 2nd *", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "[FLOWER] : 20 points for 1st, 10 for 2nd, 5 for 3rd *", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "[BERRY] : 7 points for 3 berries, 15 for 5 berries, and 20 for 7 berries. Start again after 20.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "[NUT] : 1 point per nut", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "[BUG] : Flip all your Bug Tokens (like coins). Bugs that land [BUG] are 3 points, Bugs that lands [BUG_BOTTOM] are 1 point.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "Ties are friendly. If there are ties on the [OOPS] or [FLOWER] tracks, tied players get the same reward.  You must have at least one to gain points for their respective types.", "Duration": 0, "Prev": "", "Next": "", "ViewLink": "", "Button": "", "Button URL": ""}, {"ID": "", "Type": "step", "Image": "https://www.dropbox.com/scl/fi/ar8yymygbjj0iy3z8whkq/scoring.webp?rlkey=0vq5tgodp47abi6q1ogdxac61&dl=1", "Preview": "", "Text": "The player with the most points wins. If tied, share the joy or play again!\r", "Duration": 0, "Prev": "", "Next": "END", "ViewLink": "", "Button": "", "Button URL": ""}]
