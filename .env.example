# Copy this to .env and fill in values for your environment.
# .env is gitignored — never commit it.

ENVIRONMENT=production

# Python binary name (python3 on most servers)
PYTHON=python3

# Subdirectory prefix if the app is not at the domain root.
# Leave as / for root deploys (e.g. http://localhost:8000/).
# Set to /playbook-test for https://zapsheets.com/playbook-test/ deploys.
BASE_PATH=/

# Public-facing domain (no trailing slash). Combined with BASE_PATH to build
# absolute URLs where needed (e.g. TRMNL icon).
# Example: https://zapsheets.com
APP_DOMAIN=http://localhost:8000
